<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>IeltsTeachingAssistant</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AppxPackage>false</AppxPackage>
    <WindowsSdkPackageVersion>10.0.22621.52</WindowsSdkPackageVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Production v1.1 metadata -->
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Company>IELTS Teaching Assistant</Company>
    <Product>IELTS Teaching Assistant</Product>
    <Description>AI-powered IELTS teaching and evaluation assistant</Description>
    <Copyright>Copyright © 2026 IELTS Teaching Assistant</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI 3 / Windows App SDK -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />

    <!-- MVVM Toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.1.240916" />

    <!-- EF Core + SQLite -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Google Cloud Vertex AI -->
    <PackageReference Include="Google.Cloud.AIPlatform.V1" Version="3.16.0" />

    <!-- Audio -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!-- Charts -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.0-rc3.3" />

    <!-- PDF Export -->
    <PackageReference Include="QuestPDF" Version="2024.12.2" />

    <!-- Excel Import/Export -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />

    <!-- Password Hashing -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- DI -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />

    <!-- Notifications -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <!-- Localization resources -->
  <ItemGroup>
    <PRIResource Include="Strings\**\*.resw" />
  </ItemGroup>

  <!-- Data files -->
  <ItemGroup>
    <Content Include="Data\Descriptors\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy Views and Controls subfolders containing .xbf files to the publish directory -->
  <Target Name="CopyXamlSubfoldersToPublish" AfterTargets="Publish">
    <ItemGroup>
      <XamlSubfolders Include="$(OutputPath)Views\**\*.xbf" />
      <XamlSubfolders Include="$(OutputPath)Controls\**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(XamlSubfolders)" 
          DestinationFolder="$(PublishDir)%(RecursiveDir)" 
          SkipUnchangedFiles="true" />
  </Target>
</Project>

