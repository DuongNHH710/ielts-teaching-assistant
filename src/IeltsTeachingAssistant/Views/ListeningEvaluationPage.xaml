<Page
    x:Class="IeltsTeachingAssistant.Views.ListeningEvaluationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:IeltsTeachingAssistant.Models"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Listening Evaluation Workspace" Style="{StaticResource PageTitleStyle}" />
        </Grid>

        <!-- Status InfoBar -->
        <InfoBar Grid.Row="1" x:Name="StatusInfo" IsOpen="False" Margin="0,0,0,16" />

        <!-- Student & Score Selection -->
        <Grid Grid.Row="2" ColumnSpacing="16" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Student Select -->
            <ComboBox Grid.Column="0" Header="Student" 
                      x:Name="StudentCombo"
                      PlaceholderText="Select student..." 
                      HorizontalAlignment="Stretch" />

            <!-- Band Score Slider -->
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Listening Band Score" FontSize="12" FontWeight="SemiBold" Opacity="0.8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="ScoreSlider" Minimum="0" Maximum="9" StepFrequency="0.5" Value="6.0" TickFrequency="0.5" TickPlacement="Outside" />
                    <TextBlock Grid.Column="1" x:Name="ScoreText" Text="{Binding Value, ElementName=ScoreSlider, Mode=OneWay}" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold" FontSize="16" Width="30" />
                </Grid>
            </StackPanel>

            <!-- Save Action Button -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                <Button x:Name="SaveButton" Content="Save Evaluation" Click="SaveButton_Click" Style="{StaticResource AccentButtonStyle}" Height="40" Padding="20,0" />
                <Button x:Name="ClearButton" Content="Clear Workspace" Click="ClearButton_Click" Style="{StaticResource DefaultButtonStyle}" Height="40" />
            </StackPanel>
        </Grid>

        <!-- Main 2-Column Workspace -->
        <Grid Grid.Row="3" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Side: Inputs -->
            <Grid Grid.Column="0" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Listening Script Input -->
                <TextBox Grid.Row="0" x:Name="ScriptInput"
                         Header="Listening Script / Task Context" 
                         PlaceholderText="Paste the audio transcript or listening script text here..." 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />

                <!-- Student Answers Input -->
                <TextBox Grid.Row="1" x:Name="AnswersInput"
                         Header="Student's Answers" 
                         PlaceholderText="Enter the student's answers (e.g. Q1: active, Q2: schedule, Q3: fourteen, or raw answers)..." 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />

                <!-- Action Button -->
                <Button Grid.Row="2" x:Name="AnalyzeButton" 
                        Click="AnalyzeButton_Click"
                        Style="{StaticResource AccentButtonStyle}" 
                        HorizontalAlignment="Stretch" Height="44">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="GradingProgress" IsActive="False" Width="16" Height="16" Margin="0,0,8,0" Foreground="White" />
                        <FontIcon Glyph="&#xE945;" FontSize="14" />
                        <TextBlock Text="Analyze Auditory &amp; Spelling with AI" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Right Side: AI Diagnostic Output -->
            <Border Grid.Column="1" Style="{StaticResource CardOuterShellStyle}">
                <Border Style="{StaticResource PremiumCardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="Auditory &amp; Spelling Analysis" Style="{StaticResource SectionHeaderStyle}" />

                        <!-- Markdown Content Scroll -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="AnalysisOutput" 
                                       Text="AI diagnostic analysis will appear here after clicking analyze." 
                                       TextWrapping="Wrap" 
                                       FontSize="14" 
                                       Opacity="0.8" 
                                       IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Page>
