<Page
    x:Class="IeltsTeachingAssistant.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:IeltsTeachingAssistant.ViewModels"
    xmlns:views="using:IeltsTeachingAssistant.Views"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid Padding="{StaticResource PagePadding}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="32">

                <!-- ═══ Page Header ═══ -->
                <StackPanel Spacing="4">
                    <TextBlock x:Name="GreetingText"
                               Style="{StaticResource PageTitleStyle}"
                               x:Uid="DashboardGreeting" />
                    <TextBlock x:Name="DateText"
                               FontSize="{StaticResource BodyLargeFontSize}"
                               Opacity="0.6" />
                </StackPanel>

                <!-- ═══ Quick Access Panel ═══ -->
                <StackPanel Spacing="8">
                    <TextBlock Text="QUICK ACCESS" Style="{StaticResource OverlineStyle}" />
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Evaluate New Task Card -->
                        <Button Grid.Column="0" Style="{StaticResource QuickActionButtonStyle}"
                                Click="EvaluateNewTask_Click">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="{StaticResource MediumCornerRadius}"
                                        Width="48" Height="48">
                                    <FontIcon Glyph="&#xECAD;" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Evaluate New Task" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Grading workspace" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- View Active Classes Card -->
                        <Button Grid.Column="1" Style="{StaticResource QuickActionButtonStyle}"
                                Click="ViewClasses_Click">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource SuccessBrush}"
                                        CornerRadius="{StaticResource MediumCornerRadius}"
                                        Width="48" Height="48">
                                    <FontIcon Glyph="&#xE902;" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="View Active Classes" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Manage schedules" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Pending Grading Card -->
                        <Button Grid.Column="2" Style="{StaticResource QuickActionButtonStyle}"
                                Click="PendingGrading_Click">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource WarningBrush}"
                                        CornerRadius="{StaticResource MediumCornerRadius}"
                                        Width="48" Height="48">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Pending Grading" FontSize="16" FontWeight="SemiBold" />
                                        <Border Background="{StaticResource ErrorBrush}" CornerRadius="10" Padding="6,1,6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.PendingGradingCount, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Awaiting review" FontSize="12" Opacity="0.6" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- ═══ Stats Overview ═══ -->
                <Grid ColumnSpacing="{StaticResource CardSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Total Students -->
                    <Border Grid.Column="0" Style="{StaticResource PremiumCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="STUDENTS" Style="{StaticResource OverlineStyle}" />
                            <TextBlock x:Name="TotalStudentsText"
                                       Text="0"
                                       Style="{StaticResource BandScoreDisplayStyle}" />
                            <TextBlock Text="Total enrolled"
                                       FontSize="12" Opacity="0.5" />
                        </StackPanel>
                    </Border>

                    <!-- Active Classes -->
                    <Border Grid.Column="1" Style="{StaticResource PremiumCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="CLASSES" Style="{StaticResource OverlineStyle}" />
                            <TextBlock x:Name="ActiveClassesText"
                                       Text="0"
                                       Style="{StaticResource BandScoreDisplayStyle}" />
                            <TextBlock Text="Active classes"
                                       FontSize="12" Opacity="0.5" />
                        </StackPanel>
                    </Border>

                    <!-- Evaluations This Month -->
                    <Border Grid.Column="2" Style="{StaticResource PremiumCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="EVALUATIONS" Style="{StaticResource OverlineStyle}" />
                            <TextBlock x:Name="MonthlyEvalsText"
                                       Text="0"
                                       Style="{StaticResource BandScoreDisplayStyle}" />
                            <TextBlock Text="This month"
                                       FontSize="12" Opacity="0.5" />
                        </StackPanel>
                    </Border>

                    <!-- Average Band -->
                    <Border Grid.Column="3" Style="{StaticResource PremiumCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="AVG. BAND" Style="{StaticResource OverlineStyle}" />
                            <TextBlock x:Name="AvgBandText"
                                       Text="—"
                                       Style="{StaticResource BandScoreDisplayStyle}" />
                            <TextBlock Text="Overall average"
                                       FontSize="12" Opacity="0.5" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══ Performance Trend & Urgent Alerts ═══ -->
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Line Chart Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}" Padding="20">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Overall Performance Progression (Last 4 Weeks)" Style="{StaticResource SectionHeaderStyle}" />
                                <lvc:CartesianChart Grid.Row="1" Series="{x:Bind ViewModel.OverallProgressSeries, Mode=OneWay}" XAxes="{x:Bind ViewModel.XAxes, Mode=OneWay}" YAxes="{x:Bind ViewModel.YAxes, Mode=OneWay}" Height="280" />
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Urgent Alerts Card -->
                    <Border Grid.Column="1" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}" Padding="20">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Spacing="4">
                                    <TextBlock Text="Urgent Alerts" Style="{StaticResource SectionHeaderStyle}" Foreground="{StaticResource ErrorBrush}" />
                                    <TextBlock Text="Students significantly below target band goals" FontSize="12" Opacity="0.6" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <!-- Empty Alerts State -->
                                        <TextBlock Text="All students are currently tracking close to or above their target goals." 
                                                   FontSize="13" Opacity="0.6" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32,0,0"
                                                   Visibility="{x:Bind views:DashboardPage.AlertsEmptyVisibility(ViewModel.UrgentAlerts.Count), Mode=OneWay}" />

                                        <!-- Alerts List -->
                                        <ListView ItemsSource="{x:Bind ViewModel.UrgentAlerts, Mode=OneWay}" SelectionMode="None"
                                                  Visibility="{x:Bind views:DashboardPage.AlertsListVisibility(ViewModel.UrgentAlerts.Count), Mode=OneWay}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="vm:UrgentAlertItem">
                                                    <Grid Padding="8,10" Margin="0,4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{x:Bind StudentName}" FontSize="13" FontWeight="SemiBold" />
                                                            <TextBlock Text="{x:Bind ClassName}" FontSize="11" Opacity="0.5" />
                                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                                                <TextBlock Text="Target:" FontSize="10" Opacity="0.6" />
                                                                <TextBlock Text="{x:Bind TargetBand}" FontSize="10" FontWeight="SemiBold" />
                                                                <TextBlock Text="Current:" FontSize="10" Opacity="0.6" Margin="6,0,0,0" />
                                                                <TextBlock Text="{x:Bind CurrentBand}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <ToggleButton Grid.Column="1" Content="{x:Bind Status}" Style="{StaticResource OutlineTagButtonStyle}" IsChecked="True" Foreground="{StaticResource ErrorBrush}" BorderBrush="{StaticResource ErrorBrush}" Padding="6,2" FontSize="10" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- ═══ Recent Activity ═══ -->
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Recent Activity"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <HyperlinkButton Grid.Column="1" Content="View all"
                                         VerticalAlignment="Bottom" Click="ViewAllRecentActivity_Click" />
                    </Grid>

                    <Border Style="{StaticResource PremiumCardStyle}"
                            Padding="0">
                        <ListView x:Name="RecentActivityList"
                                  SelectionMode="None"
                                  ItemsSource="{x:Bind ViewModel.RecentEvaluations, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="20,14" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Type Icon -->
                                        <Border Grid.Column="0" Width="36" Height="36"
                                                CornerRadius="{StaticResource SmallCornerRadius}"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE720;" FontSize="16"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Student + Type -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding StudentName}"
                                                       FontWeight="Medium" />
                                            <TextBlock Text="{Binding EvaluationType}"
                                                       FontSize="12" Opacity="0.5" />
                                        </StackPanel>

                                        <!-- Band Score -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding BandScore}"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                        <!-- Date -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Date}"
                                                   FontSize="12" Opacity="0.4"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Empty State -->
                    <Border x:Name="EmptyStatePanel"
                            Style="{StaticResource PremiumCardStyle}"
                            Visibility="Collapsed"
                            Padding="40"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="48" Opacity="0.3" />
                            <TextBlock Text="No evaluations yet"
                                       FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Start by creating a class and adding students, then evaluate their Speaking or Writing tests."
                                       FontSize="13" Opacity="0.5"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="400" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
