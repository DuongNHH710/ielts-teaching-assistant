<Page
    x:Class="IeltsTeachingAssistant.Views.StudentManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:IeltsTeachingAssistant.Models"
    xmlns:views="using:IeltsTeachingAssistant.Views"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Spacing="24" Margin="0,0,0,24">
            <Grid>
                <TextBlock Text="Student management" Style="{StaticResource PageTitleStyle}" />
                <Button Content="Add student" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="AddStudent_Click" />
            </Grid>
            <TextBlock Text="Manage students and track their performance." Opacity="0.6" Margin="0,-16,0,0" />
        </StackPanel>
        
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>
            
            <ListView Grid.Column="0" ItemsSource="{x:Bind ViewModel.Students, Mode=OneWay}" SelectionMode="Single" SelectedItem="{x:Bind ViewModel.SelectedStudent, Mode=TwoWay}" Padding="0,0,12,0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Student">
                    <Border Margin="0,0,0,12" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- Student Name & Phone -->
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16" CharacterSpacing="-10" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE712;" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind Phone}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Assigned Class -->
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Class" FontSize="10" Opacity="0.6" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8F9;" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Class.Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Speaking Avg -->
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Speaking" FontSize="10" Opacity="0.6" />
                                    <TextBlock Text="{Binding AverageSpeakingBand}" FontWeight="SemiBold" FontSize="16" />
                                </StackPanel>

                                <!-- Writing Avg -->
                                <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Writing" FontSize="10" Opacity="0.6" />
                                    <TextBlock Text="{Binding AverageWritingBand}" FontWeight="SemiBold" FontSize="16" />
                                </StackPanel>
                                
                                <!-- Target Score -->
                                <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Target" FontSize="10" Opacity="0.6" />
                                    <TextBlock Text="{Binding TargetBandScore}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource WarningBrush}" />
                                </StackPanel>
                                
                                <!-- Overall Score -->
                                <StackPanel Grid.Column="5" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="Overall" FontSize="10" Opacity="0.6" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding OverallBand}" FontWeight="Bold" FontSize="20" Foreground="{ThemeResource SystemAccentColor}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            </ListView>

            <!-- Detail Panel -->
            <Border Grid.Column="1" Style="{StaticResource CardOuterShellStyle}" Visibility="{x:Bind views:StudentManagementPage.DetailVisibility(ViewModel.SelectedStudent), Mode=OneWay}">
                <Border Style="{StaticResource PremiumCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <!-- PERFORMANCE HEADER -->
                        <Border Grid.Row="0" Margin="0,0,0,16" Style="{StaticResource CardOuterShellStyle}">
                            <Border Style="{StaticResource PremiumCardStyle}" Padding="16">
                                <StackPanel Spacing="16">
                                    <Grid>
                                        <TextBlock Text="Performance" Style="{StaticResource OverlineStyle}" VerticalAlignment="Center" />
                                        <Button Content="View Dashboard" Click="ViewPerformance_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Padding="8,4,8,4" FontSize="11" />
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Overall Band" FontSize="14" Opacity="0.8" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedStudent.OverallBand, Mode=OneWay}" FontWeight="Bold" FontSize="24" Foreground="{ThemeResource SystemAccentColor}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedStudent.Trend, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="16" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Reading -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Reading" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Width="60"/>
                                        <ProgressBar Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="9" Value="{x:Bind ViewModel.SelectedStudent.AverageReadingBand, Mode=OneWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Bind ViewModel.SelectedStudent.AverageReadingBand, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Width="24" TextAlignment="Right"/>

                                        <!-- Listening -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Listening" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Width="60"/>
                                        <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="9" Value="{x:Bind ViewModel.SelectedStudent.AverageListeningBand, Mode=OneWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind ViewModel.SelectedStudent.AverageListeningBand, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Width="24" TextAlignment="Right"/>

                                        <!-- Speaking -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Speaking" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Width="60"/>
                                        <ProgressBar Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="9" Value="{x:Bind ViewModel.SelectedStudent.AverageSpeakingBand, Mode=OneWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{x:Bind ViewModel.SelectedStudent.AverageSpeakingBand, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Width="24" TextAlignment="Right"/>

                                        <!-- Writing -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Writing" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Width="60"/>
                                        <ProgressBar Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="9" Value="{x:Bind ViewModel.SelectedStudent.AverageWritingBand, Mode=OneWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{x:Bind ViewModel.SelectedStudent.AverageWritingBand, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Width="24" TextAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- SETTINGS -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Student profile" Style="{StaticResource OverlineStyle}" />
                                
                                <TextBox Header="Full Name" Text="{x:Bind ViewModel.SelectedStudent.Name, Mode=TwoWay}" PlaceholderText="Enter student name" />
                                
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="Phone Number" Text="{x:Bind ViewModel.SelectedStudent.Phone, Mode=TwoWay}" PlaceholderText="e.g. +1 234..." />
                                    <NumberBox Grid.Column="1" Header="Target band" Value="{x:Bind ViewModel.SelectedStudentTargetBandScore, Mode=TwoWay}" Minimum="0" Maximum="9" SmallChange="0.5" LargeChange="1.0" SpinButtonPlacementMode="Inline" />
                                </Grid>

                                <ComboBox Header="Class assignment" 
                                          ItemsSource="{x:Bind ViewModel.AvailableClasses, Mode=OneWay}" 
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{x:Bind ViewModel.SelectedStudentClassId, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                                
                                <TextBox Header="Teacher Notes" Text="{x:Bind ViewModel.SelectedStudent.Notes, Mode=TwoWay}" AcceptsReturn="True" Height="100" PlaceholderText="Add private notes about this student's progress or learning style..." TextWrapping="Wrap"/>

                                <Grid ColumnSpacing="12" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Save changes" Click="SaveStudentChanges_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="Delete student" Click="DeleteStudent_Click" Style="{StaticResource DefaultButtonStyle}" Foreground="Red" HorizontalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Page>
