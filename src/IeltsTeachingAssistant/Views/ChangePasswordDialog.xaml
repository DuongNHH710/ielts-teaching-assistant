<ContentDialog
    x:Class="IeltsTeachingAssistant.Views.ChangePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Change Master Password"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="Dialog_PrimaryButtonClick">

    <StackPanel Spacing="12" Width="360">
        <PasswordBox x:Name="CurrentPasswordBox" Header="Current Password"
                     PlaceholderText="Enter current password"
                     PasswordChanged="Fields_Changed" />
        <PasswordBox x:Name="NewPasswordBox" Header="New Password"
                     PlaceholderText="Enter new password"
                     PasswordChanged="Fields_Changed" />
        <PasswordBox x:Name="ConfirmPasswordBox" Header="Confirm New Password"
                     PlaceholderText="Re-enter new password"
                     PasswordChanged="Fields_Changed" />
        <TextBlock x:Name="MismatchText" Text="New passwords do not match."
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   Visibility="Collapsed" />
        <TextBlock x:Name="ErrorText"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   Visibility="Collapsed" TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
