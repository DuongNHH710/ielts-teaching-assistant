<Page
    x:Class="IeltsTeachingAssistant.Views.WritingEvaluationPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:IeltsTeachingAssistant.Models"
    xmlns:views="using:IeltsTeachingAssistant.Views"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <DataTemplate x:Key="WritingTaskTemplate" x:DataType="models:WritingTask">
            <StackPanel Spacing="16">
                
                <TextBox Header="Task Type" Text="{Binding TaskType, Mode=TwoWay}" 
                         Visibility="{x:Bind views:WritingEvaluationPage.Task1Visibility(TaskNumber)}" />
                
                <TextBox Header="Writing Prompt" Text="{Binding Prompt, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" Height="80" />
                
                <TextBox Header="Submission Text" Text="{Binding SubmissionText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" Height="200" />
                
                <Button Content="Auto-Grade with AI" 
                        Command="{Binding ElementName=RootPage, Path=ViewModel.GradeWithAiCommand}" 
                        CommandParameter="{Binding}" 
                        HorizontalAlignment="Right" />

                <!-- Criteria 2x2 Grid -->
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Task Achievement -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Task Achievement" FontWeight="SemiBold" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="9" StepFrequency="0.5" Value="{Binding TaskAchievement, Mode=TwoWay}" TickFrequency="0.5" TickPlacement="Outside" ValueChanged="Slider_ValueChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding TaskAchievement}" VerticalAlignment="Center" Margin="16,0,0,0" Width="30" />
                                </Grid>
                                <TextBox Header="AI Comment" IsReadOnly="True" Text="{Binding TaskAchievementAIComment, Mode=TwoWay}" TextWrapping="Wrap" />
                                <TextBox Header="Teacher Comment" Text="{Binding TaskAchievementTeacherComment, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="TeacherComment_TextChanged" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Coherence and Cohesion -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Coherence and Cohesion" FontWeight="SemiBold" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="9" StepFrequency="0.5" Value="{Binding CoherenceCohesion, Mode=TwoWay}" TickFrequency="0.5" TickPlacement="Outside" ValueChanged="Slider_ValueChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding CoherenceCohesion}" VerticalAlignment="Center" Margin="16,0,0,0" Width="30" />
                                </Grid>
                                <TextBox Header="AI Comment" IsReadOnly="True" Text="{Binding CoherenceCohesionAIComment, Mode=TwoWay}" TextWrapping="Wrap" />
                                <TextBox Header="Teacher Comment" Text="{Binding CoherenceCohesionTeacherComment, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="TeacherComment_TextChanged" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Lexical Resource -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Lexical Resource" FontWeight="SemiBold" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="9" StepFrequency="0.5" Value="{Binding LexicalResource, Mode=TwoWay}" TickFrequency="0.5" TickPlacement="Outside" ValueChanged="Slider_ValueChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding LexicalResource}" VerticalAlignment="Center" Margin="16,0,0,0" Width="30" />
                                </Grid>
                                <TextBox Header="AI Comment" IsReadOnly="True" Text="{Binding LexicalResourceAIComment, Mode=TwoWay}" TextWrapping="Wrap" />
                                <TextBox Header="Teacher Comment" Text="{Binding LexicalResourceTeacherComment, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="TeacherComment_TextChanged" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Grammatical Range -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Grammatical Range and Accuracy" FontWeight="SemiBold" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="9" StepFrequency="0.5" Value="{Binding GrammaticalRange, Mode=TwoWay}" TickFrequency="0.5" TickPlacement="Outside" ValueChanged="Slider_ValueChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding GrammaticalRange}" VerticalAlignment="Center" Margin="16,0,0,0" Width="30" />
                                </Grid>
                                <TextBox Header="AI Comment" IsReadOnly="True" Text="{Binding GrammaticalRangeAIComment, Mode=TwoWay}" TextWrapping="Wrap" />
                                <TextBox Header="Teacher Comment" Text="{Binding GrammaticalRangeTeacherComment, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="TeacherComment_TextChanged" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Writing Evaluation" Style="{StaticResource PageTitleStyle}" />
            <ToggleSwitch Header="Focus Mode" IsOn="{x:Bind ViewModel.IsFocusMode, Mode=TwoWay}" HorizontalAlignment="Right" />
        </Grid>
        
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay}" 
                 Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}" 
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" 
                 Margin="0,0,0,16"/>
        
        <ComboBox Grid.Row="2" Header="Student" ItemsSource="{x:Bind ViewModel.Students, Mode=OneWay}" DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.Evaluation.Student, Mode=TwoWay}" PlaceholderText="Select student..." HorizontalAlignment="Stretch" Margin="0,0,0,16" />

        <!-- Horizontal Session Summary -->
        <Border Grid.Row="3" Margin="0,0,0,24" Style="{StaticResource CardOuterShellStyle}">
            <Border Style="{StaticResource PremiumCardStyle}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <TextBlock Text="Overall Band:" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.Evaluation.OverallBand, Mode=OneWay}" Style="{StaticResource BandScoreDisplayStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Task Ach.:" Opacity="0.6" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.Evaluation.TaskAchievement, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Coh/Coh:" Opacity="0.6" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.Evaluation.CoherenceCohesion, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Lexical:" Opacity="0.6" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.Evaluation.LexicalResource, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Grammar:" Opacity="0.6" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.Evaluation.GrammaticalRange, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="Save Session" Command="{x:Bind ViewModel.SaveSessionCommand}" Style="{StaticResource AccentButtonStyle}" Margin="16,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Grid Grid.Row="4">
            <!-- SIMULTANEOUS MODE -->
            <ScrollViewer Visibility="{x:Bind ViewModel.SimultaneousModeVisibility, Mode=OneWay}" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Evaluation.Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:WritingTask">
                            <Border Style="{StaticResource CardOuterShellStyle}" Margin="0,0,0,24">
                                <Border Style="{StaticResource PremiumCardStyle}">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="{x:Bind views:WritingEvaluationPage.FormatTaskTitle(TaskNumber)}" Style="{StaticResource OverlineStyle}" />
                                        <ContentPresenter Content="{x:Bind}" ContentTemplate="{StaticResource WritingTaskTemplate}" />
                                    </StackPanel>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- FOCUS MODE -->
            <Pivot Visibility="{x:Bind ViewModel.FocusModeVisibility, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Evaluation.Tasks}">
                <Pivot.HeaderTemplate>
                    <DataTemplate x:DataType="models:WritingTask">
                        <TextBlock Text="{x:Bind views:WritingEvaluationPage.FormatTaskTitle(TaskNumber)}" />
                    </DataTemplate>
                </Pivot.HeaderTemplate>
                <Pivot.ItemTemplate>
                    <DataTemplate x:DataType="models:WritingTask">
                        <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                            <Border Style="{StaticResource CardOuterShellStyle}" Margin="0,0,0,24">
                                <Border Style="{StaticResource PremiumCardStyle}">
                                    <ContentPresenter Content="{x:Bind}" ContentTemplate="{StaticResource WritingTaskTemplate}" />
                                </Border>
                            </Border>
                        </ScrollViewer>
                    </DataTemplate>
                </Pivot.ItemTemplate>
            </Pivot>
        </Grid>
    </Grid>
</Page>
