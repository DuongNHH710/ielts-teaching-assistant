<Page
    x:Class="IeltsTeachingAssistant.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="32" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <!-- Google Cloud -->
            <StackPanel Spacing="16">
                <TextBlock Text="GOOGLE CLOUD" Style="{StaticResource OverlineStyle}" />
                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBox Header="Project ID" />
                        <TextBox Header="Region" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Credentials File Path" IsReadOnly="True" />
                            <Button Content="Browse" VerticalAlignment="Bottom" Grid.Column="1" />
                        </Grid>
                        <Button Content="Test Connection" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- AI Model -->
            <StackPanel Spacing="16">
                <TextBlock Text="AI MODEL" Style="{StaticResource OverlineStyle}" />
                <Border Style="{StaticResource ElevatedCardStyle}">
                    <ComboBox Header="Preferred Model" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Gemini 2.5 Flash" />
                        <ComboBoxItem Content="Gemini 2.5 Pro" />
                    </ComboBox>
                </Border>
            </StackPanel>

            <!-- Security -->
            <StackPanel Spacing="16">
                <TextBlock Text="SECURITY" Style="{StaticResource OverlineStyle}" />
                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackPanel Spacing="12">
                        <Button Content="Change Master Password" />
                        <ToggleSwitch Header="Enable Windows Hello / Biometrics" IsOn="False" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
