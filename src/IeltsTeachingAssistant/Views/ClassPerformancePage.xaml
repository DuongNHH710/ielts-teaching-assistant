<Page
    x:Class="IeltsTeachingAssistant.Views.ClassPerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:IeltsTeachingAssistant.ViewModels"
    xmlns:views="using:IeltsTeachingAssistant.Views"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER SECTION -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Click="BackButton_Click" Style="{StaticResource QuickActionButtonStyle}" VerticalAlignment="Center" Margin="0,0,16,0" Padding="12">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="Class Performance Dashboard" Style="{StaticResource OverlineStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ClassName, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Performance statistics and student progress overview." Opacity="0.6" FontSize="14" />
            </StackPanel>
        </Grid>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Summary Cards -->
                    <RowDefinition Height="Auto" /> <!-- Charts -->
                    <RowDefinition Height="*" />    <!-- Student List & Recent Evals -->
                </Grid.RowDefinitions>

                <!-- 1. SUMMARY CARDS -->
                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card: Class Avg Band -->
                    <Border Grid.Column="0" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="CLASS AVERAGE" Style="{StaticResource OverlineStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.ClassOverallBandString, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" />
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE945;" FontSize="32" Opacity="0.3" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Card: Class Size -->
                    <Border Grid.Column="1" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="ACTIVE STUDENTS" Style="{StaticResource OverlineStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.StudentCount, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="MediumSeaGreen" />
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE716;" FontSize="32" Opacity="0.3" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Card: Total Evaluations -->
                    <Border Grid.Column="2" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL EVALUATIONS" Style="{StaticResource OverlineStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.TotalEvaluations, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="DarkTurquoise" />
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xECAD;" FontSize="32" Opacity="0.3" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Card: Target Rate -->
                    <Border Grid.Column="3" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="TARGET REACHED RATE" Style="{StaticResource OverlineStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.TargetAchievementRateString, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="Orange" />
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="32" Opacity="0.3" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- 2. CHARTS -->
                <Grid Grid.Row="1" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Grade Distribution Bar Chart -->
                    <Border Grid.Column="0" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Score Distribution (Number of Students)" Style="{StaticResource SectionHeaderStyle}" />
                                <lvc:CartesianChart Grid.Row="1" Series="{x:Bind ViewModel.DistributionSeries, Mode=OneWay}" XAxes="{x:Bind ViewModel.DistributionXAxes, Mode=OneWay}" YAxes="{x:Bind ViewModel.DistributionYAxes, Mode=OneWay}" Height="260" />
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Right: Class Average Progression Line Chart -->
                    <Border Grid.Column="1" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Class Progression Trend" Style="{StaticResource SectionHeaderStyle}" />
                                <lvc:CartesianChart Grid.Row="1" Series="{x:Bind ViewModel.ClassTrendSeries, Mode=OneWay}" XAxes="{x:Bind ViewModel.ClassTrendXAxes, Mode=OneWay}" YAxes="{x:Bind ViewModel.ClassTrendYAxes, Mode=OneWay}" Height="260" />
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- 3. STUDENT ROSTER & RECENT EVALUATIONS -->
                <Grid Grid.Row="2" Height="500" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Student Roster Table -->
                    <Border Grid.Column="0" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Student Performance Matrix" Style="{StaticResource SectionHeaderStyle}" />

                                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Students, Mode=OneWay}" SelectionMode="None">
                                    <!-- Header Row -->
                                    <ListView.Header>
                                        <Grid Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="1.5*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="NAME" FontSize="11" FontWeight="Bold" Opacity="0.6" />
                                            <TextBlock Grid.Column="1" Text="SPEAKING" FontSize="11" FontWeight="Bold" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="WRITING" FontSize="11" FontWeight="Bold" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="OVERALL" FontSize="11" FontWeight="Bold" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="TARGET" FontSize="11" FontWeight="Bold" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="STATUS" FontSize="11" FontWeight="Bold" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="ACTION" FontSize="11" FontWeight="Bold" Opacity="0.6" HorizontalAlignment="Right" />
                                        </Grid>
                                    </ListView.Header>

                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ClassStudentItem">
                                            <Grid Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="2.5*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Student Name -->
                                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                <!-- Speaking Average -->
                                                <TextBlock Grid.Column="1" Text="{x:Bind SpeakingBand}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                <!-- Writing Average -->
                                                <TextBlock Grid.Column="2" Text="{x:Bind WritingBand}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                <!-- Overall Band -->
                                                <TextBlock Grid.Column="3" Text="{x:Bind CurrentBand}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                <!-- Target Band -->
                                                <TextBlock Grid.Column="4" Text="{x:Bind TargetBand}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                <!-- Status Badge -->
                                                <Border Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,4,8,4" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                    <TextBlock Text="{x:Bind StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind views:ClassPerformancePage.ConvertHexToBrush(StatusColor)}" />
                                                </Border>

                                                <!-- Action Button -->
                                                <Button Grid.Column="6" Content="View Stats" FontSize="11" Click="ViewStudentStats_Click" Tag="{x:Bind Id}" Style="{StaticResource DefaultButtonStyle}" Padding="8,4,8,4" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Recent Class Evaluations Timeline -->
                    <Border Grid.Column="1" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Recent Class Activity" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Grid.Row="1">
                                    <TextBlock Text="No recent evaluations." FontSize="13" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind views:ClassPerformancePage.ActivityEmptyVisibility(ViewModel.RecentEvaluations.Count), Mode=OneWay}" />
                                    
                                    <ListView ItemsSource="{x:Bind ViewModel.RecentEvaluations, Mode=OneWay}" SelectionMode="None" Visibility="{x:Bind views:ClassPerformancePage.ActivityListVisibility(ViewModel.RecentEvaluations.Count), Mode=OneWay}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ClassRecentEvalItem">
                                                <Grid Padding="8" Margin="0,4,0,4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <FontIcon Glyph="{x:Bind Icon}" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{x:Bind StudentName}" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind DateString}" FontSize="10" Opacity="0.6" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{x:Bind OverallBandString}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
