<Page
    x:Class="IeltsTeachingAssistant.Views.StudentPerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:IeltsTeachingAssistant.ViewModels"
    xmlns:views="using:IeltsTeachingAssistant.Views"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <!-- Standard Value Converters -->
        <x:Double x:Key="ProgressWidth">200</x:Double>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER SECTION -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Click="BackButton_Click" Style="{StaticResource QuickActionButtonStyle}" VerticalAlignment="Center" Margin="0,0,16,0" Padding="12">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="Student Performance Dashboard" Style="{StaticResource OverlineStyle}" />
                <TextBlock Text="{x:Bind ViewModel.StudentName, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ClassName, Mode=OneWay}" Opacity="0.6" FontSize="14" />
            </StackPanel>
        </Grid>

        <!-- MAIN SCROLLABLE CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Summary Cards -->
                    <RowDefinition Height="Auto" /> <!-- Chart & Breakdown -->
                    <RowDefinition Height="Auto" /> <!-- Past Evaluations Header -->
                    <RowDefinition Height="*" />    <!-- Past Evaluations Master-Detail -->
                </Grid.RowDefinitions>

                <!-- 1. SUMMARY CARDS -->
                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card: Overall Band -->
                    <Border Grid.Column="0" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="OVERALL BAND" Style="{StaticResource OverlineStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.OverallBand, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" />
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE945;" FontSize="32" Opacity="0.3" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Card: Target Goal -->
                    <Border Grid.Column="1" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <TextBlock Text="TARGET PROGRESS" Style="{StaticResource OverlineStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Value="{x:Bind ViewModel.TargetProgress, Mode=OneWay}" Minimum="0" Maximum="100" VerticalAlignment="Center" HorizontalAlignment="Stretch" Foreground="{ThemeResource SystemAccentColor}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TargetProgressString, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Opacity="0.6" FontSize="11">
                                        <Run Text="Target: " /><Run Text="{x:Bind ViewModel.TargetBand, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="32" Opacity="0.3" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Card: Speaking Average -->
                    <Border Grid.Column="2" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="SPEAKING AVG" Style="{StaticResource OverlineStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.AvgSpeaking, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="MediumSeaGreen" />
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE720;" FontSize="32" Opacity="0.3" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Card: Writing Average -->
                    <Border Grid.Column="3" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="WRITING AVG" Style="{StaticResource OverlineStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.AvgWriting, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="Orange" />
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE8A5;" FontSize="32" Opacity="0.3" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- 2. CHART & BREAKDOWN -->
                <Grid Grid.Row="1" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Line Chart Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Score Trend Over Time" Style="{StaticResource SectionHeaderStyle}" />
                                <lvc:CartesianChart Grid.Row="1" Series="{x:Bind ViewModel.TrendSeries, Mode=OneWay}" XAxes="{x:Bind ViewModel.XAxes, Mode=OneWay}" YAxes="{x:Bind ViewModel.YAxes, Mode=OneWay}" Height="280" />
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Sub-criteria breakdown Card -->
                    <Border Grid.Column="1" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid RowSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Criteria Averages" Style="{StaticResource SectionHeaderStyle}" />

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="16">
                                        <!-- SPEAKING CRITERIA -->
                                        <TextBlock Text="SPEAKING" Style="{StaticResource OverlineStyle}" Foreground="MediumSeaGreen" />
                                        
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <TextBlock Text="Fluency &amp; Coherence" FontSize="12" Opacity="0.8" />
                                                <TextBlock Text="{x:Bind ViewModel.SpeakingFluency, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar Value="{x:Bind ViewModel.SpeakingFluency, Mode=OneWay}" Minimum="0" Maximum="9" Foreground="MediumSeaGreen" />
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <TextBlock Text="Lexical Resource" FontSize="12" Opacity="0.8" />
                                                <TextBlock Text="{x:Bind ViewModel.SpeakingLexical, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar Value="{x:Bind ViewModel.SpeakingLexical, Mode=OneWay}" Minimum="0" Maximum="9" Foreground="MediumSeaGreen" />
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <TextBlock Text="Grammatical Range" FontSize="12" Opacity="0.8" />
                                                <TextBlock Text="{x:Bind ViewModel.SpeakingGrammar, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar Value="{x:Bind ViewModel.SpeakingGrammar, Mode=OneWay}" Minimum="0" Maximum="9" Foreground="MediumSeaGreen" />
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <TextBlock Text="Pronunciation" FontSize="12" Opacity="0.8" />
                                                <TextBlock Text="{x:Bind ViewModel.SpeakingPronunciation, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar Value="{x:Bind ViewModel.SpeakingPronunciation, Mode=OneWay}" Minimum="0" Maximum="9" Foreground="MediumSeaGreen" />
                                        </StackPanel>

                                        <!-- WRITING CRITERIA -->
                                        <TextBlock Text="WRITING" Style="{StaticResource OverlineStyle}" Foreground="Orange" Margin="0,12,0,0" />

                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <TextBlock Text="Task Achievement" FontSize="12" Opacity="0.8" />
                                                <TextBlock Text="{x:Bind ViewModel.WritingTaskAchievement, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar Value="{x:Bind ViewModel.WritingTaskAchievement, Mode=OneWay}" Minimum="0" Maximum="9" Foreground="Orange" />
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <TextBlock Text="Coherence &amp; Cohesion" FontSize="12" Opacity="0.8" />
                                                <TextBlock Text="{x:Bind ViewModel.WritingCoherence, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar Value="{x:Bind ViewModel.WritingCoherence, Mode=OneWay}" Minimum="0" Maximum="9" Foreground="Orange" />
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <TextBlock Text="Lexical Resource" FontSize="12" Opacity="0.8" />
                                                <TextBlock Text="{x:Bind ViewModel.WritingLexical, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar Value="{x:Bind ViewModel.WritingLexical, Mode=OneWay}" Minimum="0" Maximum="9" Foreground="Orange" />
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <TextBlock Text="Grammatical Range" FontSize="12" Opacity="0.8" />
                                                <TextBlock Text="{x:Bind ViewModel.WritingGrammar, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar Value="{x:Bind ViewModel.WritingGrammar, Mode=OneWay}" Minimum="0" Maximum="9" Foreground="Orange" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- 3. PAST EVALUATIONS HEADER -->
                <StackPanel Grid.Row="2" Spacing="4">
                    <TextBlock Text="Evaluation History" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="Browse and review detail results from all past IELTS speaking and writing tests." Opacity="0.6" FontSize="13" />
                </StackPanel>

                <!-- 4. PAST EVALUATIONS MASTER-DETAIL -->
                <Grid Grid.Row="3" MinHeight="450" Height="600" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Evaluation List on the left -->
                    <Border Grid.Column="0" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}" Padding="8">
                            <Grid>
                                <TextBlock Text="No past evaluations found." FontSize="14" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.NoEvaluationsLabelVisibility, Mode=OneWay}" />
                                <ListView ItemsSource="{x:Bind ViewModel.Evaluations, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedEvaluation, Mode=TwoWay}" SelectionMode="Single" Visibility="{x:Bind ViewModel.EvaluationsListVisibility, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EvaluationHistoryItem">
                                            <Grid Padding="12" Margin="0,4,0,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <FontIcon Glyph="{x:Bind Icon}" FontSize="18" Foreground="{ThemeResource SystemAccentColor}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{x:Bind DateString}" FontSize="11" Opacity="0.6" />
                                                </StackPanel>

                                                <Border Grid.Column="2" Padding="8,4,8,4" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SystemAccentColor}">
                                                     <TextBlock Text="{x:Bind OverallBandString}" FontWeight="Bold" FontSize="14" Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Evaluation Detail View on the right -->
                    <Border Grid.Column="1" Style="{StaticResource CardOuterShellStyle}">
                        <Border Style="{StaticResource PremiumCardStyle}">
                            <Grid>
                                <!-- Empty State -->
                                <TextBlock Text="Select an evaluation from the list to view its full transcript and AI/teacher comments." FontSize="14" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind views:StudentPerformancePage.DetailViewEmptyVisibility(ViewModel.SelectedEvaluation), Mode=OneWay}" />

                                <!-- Main Details -->
                                <Grid RowSpacing="16" Visibility="{x:Bind views:StudentPerformancePage.DetailViewContentVisibility(ViewModel.SelectedEvaluation), Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /> <!-- Eval Header Info -->
                                        <RowDefinition Height="*" />    <!-- Content Tab (Pivot-like Layout) -->
                                    </Grid.RowDefinitions>

                                    <!-- Detail Header -->
                                    <Grid Grid.Row="0" Padding="0,0,0,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedEvaluation.Title, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedEvaluation.DateString, Mode=OneWay}" FontSize="12" Opacity="0.6" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="Overall Score:" FontSize="14" VerticalAlignment="Center" Opacity="0.8" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedEvaluation.OverallBand, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Content: Sub-parts / tasks loop -->
                                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.SelectedEvaluation.SubItems, Mode=OneWay}" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EvaluationSubItem">
                                                <StackPanel Spacing="16" Margin="0,0,0,24" Padding="0,0,0,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                    
                                                    <!-- Task Title & Score Banner -->
                                                    <Grid>
                                                        <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                            <TextBlock Text="Band Score:" FontSize="13" VerticalAlignment="Center" Opacity="0.7" />
                                                            <TextBlock Text="{x:Bind OverallBand}" FontSize="16" FontWeight="Bold" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Submission Text -->
                                                    <Grid RowSpacing="6">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="Prompt &amp; Submission Transcript / Essay" Style="{StaticResource OverlineStyle}" />
                                                        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="16">
                                                            <StackPanel Spacing="12">
                                                                <TextBlock Text="{x:Bind Prompt}" FontSize="12" FontWeight="SemiBold" FontStyle="Italic" TextWrapping="Wrap" Visibility="{x:Bind PromptVisibility}" />
                                                                <TextBlock Text="{x:Bind SubmissionText}" FontSize="13" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Detailed AI & Teacher Comments Grid -->
                                                    <Grid RowSpacing="12">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Text="Evaluation Feedback &amp; Comments" Style="{StaticResource OverlineStyle}" />
                                                        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!-- Criterion 1 -->
                                                            <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <StackPanel Spacing="8">
                                                                    <Grid>
                                                                        <TextBlock Text="{x:Bind Label1}" FontSize="12" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{x:Bind Metric1}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                                                                    </Grid>
                                                                    <StackPanel Spacing="2" Visibility="{x:Bind AIComment1Visibility}">
                                                                        <TextBlock Text="AI Feedback" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}" Opacity="0.8" />
                                                                        <TextBlock Text="{x:Bind AIComment1}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel Spacing="2" Visibility="{x:Bind TeacherComment1Visibility}">
                                                                        <TextBlock Text="Teacher Feedback" FontSize="10" FontWeight="SemiBold" Foreground="MediumSeaGreen" Opacity="0.8" />
                                                                        <TextBlock Text="{x:Bind TeacherComment1}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Criterion 2 -->
                                                            <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <StackPanel Spacing="8">
                                                                    <Grid>
                                                                        <TextBlock Text="{x:Bind Label2}" FontSize="12" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{x:Bind Metric2}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                                                                    </Grid>
                                                                    <StackPanel Spacing="2" Visibility="{x:Bind AIComment2Visibility}">
                                                                        <TextBlock Text="AI Feedback" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}" Opacity="0.8" />
                                                                        <TextBlock Text="{x:Bind AIComment2}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel Spacing="2" Visibility="{x:Bind TeacherComment2Visibility}">
                                                                        <TextBlock Text="Teacher Feedback" FontSize="10" FontWeight="SemiBold" Foreground="MediumSeaGreen" Opacity="0.8" />
                                                                        <TextBlock Text="{x:Bind TeacherComment2}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Criterion 3 -->
                                                            <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <StackPanel Spacing="8">
                                                                    <Grid>
                                                                        <TextBlock Text="{x:Bind Label3}" FontSize="12" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{x:Bind Metric3}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                                                                    </Grid>
                                                                    <StackPanel Spacing="2" Visibility="{x:Bind AIComment3Visibility}">
                                                                        <TextBlock Text="AI Feedback" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}" Opacity="0.8" />
                                                                        <TextBlock Text="{x:Bind AIComment3}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel Spacing="2" Visibility="{x:Bind TeacherComment3Visibility}">
                                                                        <TextBlock Text="Teacher Feedback" FontSize="10" FontWeight="SemiBold" Foreground="MediumSeaGreen" Opacity="0.8" />
                                                                        <TextBlock Text="{x:Bind TeacherComment3}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Criterion 4 -->
                                                            <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <StackPanel Spacing="8">
                                                                    <Grid>
                                                                        <TextBlock Text="{x:Bind Label4}" FontSize="12" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{x:Bind Metric4}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                                                                    </Grid>
                                                                    <StackPanel Spacing="2" Visibility="{x:Bind AIComment4Visibility}">
                                                                        <TextBlock Text="AI Feedback" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}" Opacity="0.8" />
                                                                        <TextBlock Text="{x:Bind AIComment4}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel Spacing="2" Visibility="{x:Bind TeacherComment4Visibility}">
                                                                        <TextBlock Text="Teacher Feedback" FontSize="10" FontWeight="SemiBold" Foreground="MediumSeaGreen" Opacity="0.8" />
                                                                        <TextBlock Text="{x:Bind TeacherComment4}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
