<UserControl
    x:Class="IeltsTeachingAssistant.Controls.RubricGridPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:IeltsTeachingAssistant.Controls"
    mc:Ignorable="d"
    x:Name="RootControl">

    <!--
        4-column horizontal grid, one RubricCriterionPanel per criterion.
        Wrapped in a horizontal ScrollViewer so it doesn't overflow narrow windows.
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
        <Grid x:Name="CriteriaGrid"
              ColumnSpacing="12"
              MinWidth="800">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Criterion 0 -->
            <controls:RubricCriterionPanel
                Grid.Column="0"
                x:Name="Panel0"
                VerticalAlignment="Stretch" />

            <!-- Criterion 1 -->
            <controls:RubricCriterionPanel
                Grid.Column="1"
                x:Name="Panel1"
                VerticalAlignment="Stretch" />

            <!-- Criterion 2 -->
            <controls:RubricCriterionPanel
                Grid.Column="2"
                x:Name="Panel2"
                VerticalAlignment="Stretch" />

            <!-- Criterion 3 -->
            <controls:RubricCriterionPanel
                Grid.Column="3"
                x:Name="Panel3"
                VerticalAlignment="Stretch" />
        </Grid>
    </ScrollViewer>
</UserControl>
