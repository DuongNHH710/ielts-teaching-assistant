<UserControl
    x:Class="IeltsTeachingAssistant.Controls.MarkingGridCell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IeltsTeachingAssistant.Controls"
    xmlns:vm="using:IeltsTeachingAssistant.ViewModels.Marking"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:IeltsTeachingAssistant.Helpers"
    mc:Ignorable="d"
    x:Name="Root"
    d:DataContext="{d:DesignInstance Type=vm:CriteriaCellViewModel}">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
            BorderThickness="1" 
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="4"
            Margin="4"
            Padding="8"
            x:Name="CellBorder">
        
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Selected">
                    <Storyboard>
                        <ColorAnimation Storyboard.TargetName="CellBorder"
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                        To="#FFF2F9FB" Duration="0" /> <!-- Light blue/yellow based on mockup -->
                        <ColorAnimation Storyboard.TargetName="CellBorder"
                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                        To="#FF0078D7" Duration="0" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header when selected -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,8">
                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#FF0078D7" Margin="0,0,4,0"/>
                <TextBlock Text="Selected" FontSize="12" Foreground="#FF0078D7" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Descriptors List -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Descriptors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DescriptorViewModel">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- Checkbox for specific descriptor -->
                            <CheckBox Grid.Column="0" 
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Top"
                                      MinWidth="0"/>

                            <!-- Rich Text block -->
                            <TextBlock Grid.Column="1" 
                                       local:RichDescriptorTextBlock.FormattedText="{Binding Text}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Transparent overlay to allow clicking the whole cell -->
            <Button Grid.RowSpan="2" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch" 
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Cell_Click"
                    CornerRadius="4"/>
        </Grid>
    </Border>
</UserControl>
