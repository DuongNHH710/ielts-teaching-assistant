<UserControl
    x:Class="IeltsTeachingAssistant.Controls.SubjectiveGridControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:IeltsTeachingAssistant.ViewModels.Marking"
    xmlns:helpers="using:IeltsTeachingAssistant.Helpers"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SubjectiveGridViewModel}">

    <UserControl.Resources>
        <helpers:StringFormatConverter x:Key="StringFormatConverter" />
    </UserControl.Resources>

    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" /> <!-- Main Grid Area -->
            <ColumnDefinition Width="300" /> <!-- Right Sidebar -->
        </Grid.ColumnDefinitions>

        <!-- Dynamic Grid Container -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid x:Name="DynamicGrid" Margin="0,0,16,0">
                <!-- Code-behind will populate this -->
            </Grid>
        </ScrollViewer>

        <!-- Right Sidebar (Score Summary) -->
        <Border Grid.Column="1" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                VerticalAlignment="Top">
            
            <StackPanel Spacing="16">
                <TextBlock Text="Provisional reported band" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding OverallBandScore, Converter={StaticResource StringFormatConverter}, ConverterParameter='F1'}" 
                           FontSize="48" 
                           FontWeight="Bold" 
                           Foreground="#FFE81123" /> <!-- Red/Accent color -->
                
                <Button Content="Clear scores" Command="{Binding ClearScoresCommand}" HorizontalAlignment="Stretch" />

                <MenuFlyoutSeparator Margin="0,8"/>

                <TextBlock Text="Criterion scores" FontWeight="SemiBold" />
                
                <ItemsControl ItemsSource="{Binding CriterionScores}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CriterionScore">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" 
                                        Background="#FFE6F2FA" 
                                        CornerRadius="4" 
                                        Padding="8,4"
                                        MinWidth="32">
                                    <TextBlock Text="{Binding Score}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#FF0078D7"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <MenuFlyoutSeparator Margin="0,8"/>

                <Grid>
                    <TextBlock Text="Average of selected criteria" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding OverallBandScore, Converter={StaticResource StringFormatConverter}, ConverterParameter='F2'}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
