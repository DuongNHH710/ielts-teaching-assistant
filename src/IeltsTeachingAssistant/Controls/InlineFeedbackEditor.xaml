<UserControl
    x:Class="IeltsTeachingAssistant.Controls.InlineFeedbackEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootControl">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Mode Toggle (Editing / Suggesting) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <ToggleButton Content="Editing" Style="{StaticResource PillToggleButtonStyle}" IsChecked="True" />
            <ToggleButton Content="Suggesting" Style="{StaticResource PillToggleButtonStyle}" />
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardOuterShellStyle}" Margin="0,0,0,8">
            <Border Style="{StaticResource PremiumCardStyle}" Padding="12,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <!-- Basic Formatting -->
                        <Button FontFamily="Segoe MDL2 Assets" Content="&#xE8D4;" ToolTipService.ToolTip="Bold" Click="BoldButton_Click" Background="Transparent" BorderThickness="0" />
                        <Button FontFamily="Segoe MDL2 Assets" Content="&#xE8D5;" ToolTipService.ToolTip="Italic" Click="ItalicButton_Click" Background="Transparent" BorderThickness="0" />
                        <Button FontFamily="Segoe MDL2 Assets" Content="&#xE8DC;" ToolTipService.ToolTip="Underline" Click="UnderlineButton_Click" Background="Transparent" BorderThickness="0" />
                        <Button Content="Remove format" Click="RemoveFormatButton_Click" Background="Transparent" BorderThickness="0" />
                        <AppBarSeparator />
                        <Button Content="Clear everything" Foreground="{StaticResource ErrorColor}" Background="Transparent" BorderThickness="0" Click="ClearButton_Click" />
                    </StackPanel>
                    
                    <!-- Feedback Types -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Feedback types:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                        <ToggleButton Content="Grammar" Style="{StaticResource OutlineTagButtonStyle}" Foreground="{StaticResource FeedbackGrammarColor}" BorderBrush="{StaticResource FeedbackGrammarColor}" Click="TagButton_Click" Tag="Grammar" />
                        <ToggleButton Content="Vocabulary" Style="{StaticResource OutlineTagButtonStyle}" Foreground="{StaticResource FeedbackVocabularyColor}" BorderBrush="{StaticResource FeedbackVocabularyColor}" Click="TagButton_Click" Tag="Vocabulary" />
                        <ToggleButton Content="Spelling" Style="{StaticResource OutlineTagButtonStyle}" Foreground="{StaticResource FeedbackSpellingColor}" BorderBrush="{StaticResource FeedbackSpellingColor}" Click="TagButton_Click" Tag="Spelling" />
                        <ToggleButton Content="Coherence" Style="{StaticResource OutlineTagButtonStyle}" Foreground="{StaticResource FeedbackCoherenceColor}" BorderBrush="{StaticResource FeedbackCoherenceColor}" Click="TagButton_Click" Tag="Coherence" />
                        <ToggleButton Content="Task response" Style="{StaticResource OutlineTagButtonStyle}" Foreground="{StaticResource FeedbackTaskColor}" BorderBrush="{StaticResource FeedbackTaskColor}" Click="TagButton_Click" Tag="Task" />
                        <ToggleButton Content="Style" Style="{StaticResource OutlineTagButtonStyle}" Foreground="{StaticResource FeedbackStyleColor}" BorderBrush="{StaticResource FeedbackStyleColor}" Click="TagButton_Click" Tag="Style" />
                        <ToggleButton Content="Idea" Style="{StaticResource OutlineTagButtonStyle}" Foreground="{StaticResource FeedbackIdeaColor}" BorderBrush="{StaticResource FeedbackIdeaColor}" Click="TagButton_Click" Tag="Idea" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- RichEditBox -->
        <Border Grid.Row="2" Style="{StaticResource CardOuterShellStyle}">
            <Border Style="{StaticResource PremiumCardStyle}">
                <RichEditBox x:Name="EditorBox" 
                             AcceptsReturn="True" 
                             MinHeight="300" 
                             BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="Wrap"
                             PlaceholderText="Paste your student's writing here..."
                             LostFocus="EditorBox_LostFocus"/>
            </Border>
        </Border>
    </Grid>
</UserControl>
