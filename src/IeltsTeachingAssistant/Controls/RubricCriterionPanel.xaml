<UserControl
    x:Class="IeltsTeachingAssistant.Controls.RubricCriterionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootControl">

    <!--
        STRUCTURE: Vertical accordion for one IELTS criterion.
        The band rows (Expanders) are built entirely from code-behind to avoid
        complex XAML binding issues. Only the header / AI comment use named
        XAML elements.
    -->
    <Border CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel>

            <!-- ── Criterion header ── -->
            <Border x:Name="HeaderBorder"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CriterionNameText"
                               Grid.Column="0"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />

                    <!-- Band badge – click to toggle AI comment -->
                    <Button x:Name="BandBadgeButton"
                            Grid.Column="1"
                            Click="BandBadge_Click"
                            Width="44" Height="44"
                            CornerRadius="22"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Click to show / hide AI justification">
                        <Button.Background>
                            <SolidColorBrush x:Name="BadgeBrush" Color="#22C55E" />
                        </Button.Background>
                        <TextBlock x:Name="BandBadgeText"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <!-- ── AI Comment (hidden by default, click badge to reveal) ── -->
            <Border x:Name="AiCommentBorder"
                    Visibility="Collapsed"
                    Padding="12,8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Spacing="4">
                    <TextBlock Text="AI Feedback Details"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="AiCommentText"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Opacity="0.85" />
                </StackPanel>
            </Border>

            <!-- ── Band descriptor rows built entirely from code-behind ── -->
            <StackPanel x:Name="BandRowsHost" />

        </StackPanel>
    </Border>
</UserControl>
