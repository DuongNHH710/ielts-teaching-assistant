<Application
    x:Class="IeltsTeachingAssistant.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IeltsTeachingAssistant">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="OutfitFont">ms-appx:///Assets/Fonts/Outfit.ttf#Outfit</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Outfit.ttf#Outfit</FontFamily>

            <!-- ═══════════════════════════════════════════ -->
            <!-- Glassmorphism Materials                     -->
            <!-- ═══════════════════════════════════════════ -->
            <AcrylicBrush x:Key="GlassAcrylicBrush"
                          TintColor="#0F172A"
                          TintOpacity="0.7"
                          FallbackColor="#0F172A" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="GlassSidebarBrush" Color="#40000000" />

            <!-- ═══════════════════════════════════════════ -->
            <!-- Premium Design System Tokens               -->
            <!-- ═══════════════════════════════════════════ -->

            <!-- Band Score Color Palette -->
            <Color x:Key="BandScoreLowColor">#F43F5E</Color>         <!-- Rose - bands 1-3 -->
            <Color x:Key="BandScoreMidLowColor">#F59E0B</Color>      <!-- Amber - bands 4-5 -->
            <Color x:Key="BandScoreMidColor">#10B981</Color>         <!-- Emerald - bands 6-7 -->
            <Color x:Key="BandScoreHighColor">#3B82F6</Color>        <!-- Blue - bands 8-9 -->

            <!-- Semantic Colors -->
            <Color x:Key="SuccessColor">#10B981</Color>
            <Color x:Key="WarningColor">#F59E0B</Color>
            <Color x:Key="ErrorColor">#F43F5E</Color>
            <Color x:Key="InfoColor">#3B82F6</Color>

            <!-- Feedback Type Colors -->
            <Color x:Key="FeedbackGrammarColor">#3B82F6</Color>
            <Color x:Key="FeedbackVocabularyColor">#D97706</Color>
            <Color x:Key="FeedbackSpellingColor">#B45309</Color>
            <Color x:Key="FeedbackCoherenceColor">#8B5CF6</Color>
            <Color x:Key="FeedbackTaskColor">#0D9488</Color>
            <Color x:Key="FeedbackStyleColor">#4B5563</Color>
            <Color x:Key="FeedbackIdeaColor">#D946EF</Color>

            <SolidColorBrush x:Key="FeedbackGrammarBrush" Color="{StaticResource FeedbackGrammarColor}" />
            <SolidColorBrush x:Key="FeedbackVocabularyBrush" Color="{StaticResource FeedbackVocabularyColor}" />
            <SolidColorBrush x:Key="FeedbackSpellingBrush" Color="{StaticResource FeedbackSpellingColor}" />
            <SolidColorBrush x:Key="FeedbackCoherenceBrush" Color="{StaticResource FeedbackCoherenceColor}" />
            <SolidColorBrush x:Key="FeedbackTaskBrush" Color="{StaticResource FeedbackTaskColor}" />
            <SolidColorBrush x:Key="FeedbackStyleBrush" Color="{StaticResource FeedbackStyleColor}" />
            <SolidColorBrush x:Key="FeedbackIdeaBrush" Color="{StaticResource FeedbackIdeaColor}" />

            <!-- Status Brushes -->
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

            <!-- Typography Scale -->
            <x:Double x:Key="DisplayFontSize">34</x:Double>
            <x:Double x:Key="TitleLargeFontSize">28</x:Double>
            <x:Double x:Key="TitleFontSize">24</x:Double>
            <x:Double x:Key="SubtitleFontSize">20</x:Double>
            <x:Double x:Key="BodyLargeFontSize">16</x:Double>
            <x:Double x:Key="BodyFontSize">14</x:Double>
            <x:Double x:Key="CaptionFontSize">12</x:Double>
            <x:Double x:Key="OverlineFontSize">10</x:Double>

            <!-- Spacing Scale -->
            <Thickness x:Key="PagePadding">40,32,40,32</Thickness>
            <Thickness x:Key="SectionSpacing">0,0,0,32</Thickness>
            <Thickness x:Key="CardPadding">20,16,20,16</Thickness>
            <Thickness x:Key="SmallCardPadding">16,12,16,12</Thickness>
            <x:Double x:Key="CardSpacing">12</x:Double>
            <x:Double x:Key="ItemSpacing">8</x:Double>

            <!-- Corner Radius Scale (consistent across all components) -->
            <CornerRadius x:Key="LargeCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="MediumCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="SmallCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="PillCornerRadius">100</CornerRadius>

            <!-- Double-Bezel Card Style -->
            <Style x:Key="PremiumCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassAcrylicBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource LargeCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            </Style>

            <!-- Outer Shell for Double-Bezel Pattern -->
            <Style x:Key="CardOuterShellStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassAcrylicBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource LargeCornerRadius}" />
                <Setter Property="Padding" Value="4" />
            </Style>

            <!-- Elevated Card with Depth -->
            <Style x:Key="ElevatedCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassAcrylicBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource MediumCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource SmallCardPadding}" />
            </Style>

            <!-- Quick Action Button Style -->
            <Style x:Key="QuickActionButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="20,16,20,16" />
                <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{StaticResource GlassAcrylicBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            </Style>

            <!-- Pill Toggle Button Style (for segmented controls like Editing/Suggesting) -->
            <Style x:Key="PillToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
                <Setter Property="Padding" Value="20,8,20,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Outline Tag Button Style -->
            <Style x:Key="OutlineTagButtonStyle" TargetType="ToggleButton">
                <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}" />
                <Setter Property="Padding" Value="12,4,12,4" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <!-- Score Display Text Style -->
            <Style x:Key="BandScoreDisplayStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource OutfitFont}" />
                <Setter Property="FontSize" Value="48" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-50" />
            </Style>

            <!-- Page Title Style -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource OutfitFont}" />
                <Setter Property="FontSize" Value="{StaticResource DisplayFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-30" />
            </Style>

            <!-- Section Header Style -->
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource OutfitFont}" />
                <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-20" />
            </Style>

            <!-- Overline / Label Style -->
            <Style x:Key="OverlineStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource OutfitFont}" />
                <Setter Property="FontSize" Value="{StaticResource OverlineFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="Opacity" Value="0.6" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
