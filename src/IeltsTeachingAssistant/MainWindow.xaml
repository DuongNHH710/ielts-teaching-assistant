<Window
    x:Class="IeltsTeachingAssistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IeltsTeachingAssistant"
    Title="IELTS Teaching Assistant">

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="280"
            SelectionChanged="NavView_SelectionChanged"
            Loaded="NavView_Loaded">

            <!-- Navigation Header -->
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" Padding="4,8,0,16">
                    <FontIcon Glyph="&#xE82D;" FontSize="28" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="IELTS Assistant"
                                   FontSize="16" FontWeight="SemiBold"
                                   CharacterSpacing="-20" />
                        <TextBlock Text="Teaching Tools"
                                   FontSize="11" Opacity="0.5"
                                   CharacterSpacing="50" FontWeight="Medium" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <!-- Navigation Menu Items -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavDashboard"
                                     Content="Dashboard" Tag="Dashboard"
                                     Icon="Home" />

                <NavigationViewItem x:Name="NavClasses"
                                     Content="Classes" Tag="Classes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE902;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavEvaluations"
                                     Content="Evaluation Workspace" Tag="Evaluations">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xECAD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavStudents"
                                     Content="Student Profiles" Tag="Students">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Content Frame -->
            <Frame x:Name="ContentFrame" Padding="0">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <SlideNavigationTransitionInfo Effect="FromRight" />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Window>
